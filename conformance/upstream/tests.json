        "multikey_to_cose_rejects_algorithm_unsupported_by_current_mapping",
        "multikey_to_cose_rejects_unknown_codec",
        "policy_rejects_missing_kid",
        "portable_cose_key_vectors_roundtrip",
        "portable_cose_sign1_vectors_verify",
        "verify_fails_with_unknown_kid",
        "verify_uses_kid_for_key_selection"
