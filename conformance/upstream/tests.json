        "reject_unsigned_with_alg_not_none",
        "reject_unsigned_with_typ_not_jwt",
        "secp256k1_signed_jwt_roundtrip",
        "signed_jwt_carries_jwk_key_id",
        "standard_policy_rejects_non_jwt_typ",
        "strict_temporal_rejects_missing_exp",
        "string_or_uri_roundtrip",
        "unsigned_jwt_roundtrip"
      ]
    },
    {
      "source": "RFC9901",
      "path": "vectors/ietf-sd-jwt",
      "local_equivalent": "cargo test -p reallyme-sd-jwt",
      "notes": "SSI-owned SD-JWT vectors are portable JSON/text fixtures consumed by Rust tests and downstream SDK language lanes."
    },
    {
      "source": "I-D-OAUTH-STATUS-LIST-21",
      "path": "crates/status/tests/token_status_list_tests.rs",
      "local_equivalent": "cargo test -p reallyme-credential-status --test token_status_list_tests --all-features",
      "notes": "Local JWT and CWT Token Status List vectors cover exact draft compression, authenticated envelope types, signature verification, subject and time binding, supported bit widths, and resource bounds.",
      "test_names": [
        "cwt_round_trip_uses_tagged_sign1_and_authenticated_type",
        "cwt_verifier_rejects_untagged_sign1",
        "cwt_verifier_rejects_wrong_authenticated_type",
        "draft_21_compression_vector_matches_exactly",
        "extracts_each_supported_packed_value_width",
        "jwt_round_trip_authenticates_type_claims_and_compressed_bytes",
        "verifier_enforces_exact_subject_uri_binding",
        "verifier_rejects_a_one_bit_list_above_the_entry_limit",
        "verifier_rejects_expired_token",
        "verifier_rejects_wrong_typ_even_with_valid_signature"
      ]
    },
    {
      "source": "OIDF-OPENID4VP-CONFORMANCE",
      "path": "https://openid.net/certification/conformance-testing-for-openid-for-verifiable-presentations/",
      "local_equivalent": "external suite; no checked-in static vector equivalent",
      "notes": "The OpenID Foundation VP suite is a dynamic certification suite covering SD-JWT VC, ISO mdoc/mDL, HAIP, presentation_definition, and DCQL behavior. It is tracked as an external conformance target rather than a portable vector source."
    },
    {
      "source": "RFC7516",
      "path": "crates.io:reallyme-jose@0.4.0/tests/jwe_tests.rs",
      "local_equivalent": "cargo test -p reallyme-jose --features native jwe",
      "notes": "Internally authored compact JWE vectors over reallyme/crypto AES-GCM and Concat KDF primitives.",
      "test_names": [
        "decrypts_compact_dir_a128gcm_json",
        "decrypts_compact_dir_a192gcm_bytes",
        "decrypts_compact_dir_a256gcm_bytes",
        "derives_ecdh_es_a128gcm_cek_from_header_party_info",
        "ecdh_es_rejects_wrong_recipient_private_key",
        "encrypts_and_decrypts_p256_ecdh_es_a128gcm_json",
        "encrypts_and_decrypts_p384_ecdh_es_a192gcm_json",
        "encrypts_and_decrypts_p521_ecdh_es_a256gcm_json",
        "encrypts_compact_dir_a128gcm_json",
        "jwe_compact_vectors_decrypt_or_fail_closed",
        "rejects_compact_jwe_over_size_limit",
        "rejects_duplicate_protected_header_parameter",
        "rejects_embedded_jwk_header",
        "rejects_invalid_compact_part_count",
        "rejects_key_management_algorithm_outside_policy",
        "rejects_modified_ciphertext",
        "rejects_modified_iv",
        "rejects_modified_protected_header_aad",
        "rejects_non_empty_encrypted_key_for_dir",
        "rejects_remote_key_header",
        "rejects_tampered_authentication_tag",
        "rejects_unsupported_compression_header",
        "rejects_unsupported_critical_header",
        "rejects_wrong_direct_key"
      ]
    },
    {
      "source": "ISO18013-5",
      "path": "crates/envelopes/mdoc/tests/mdoc_tests.rs",
      "local_equivalent": "cargo test -p reallyme-mdoc",
      "notes": "Internally authored behavior fixtures only; licensed ISO test material is not vendored."
    },
    {
      "source": "RFC5280/EUDI-ARF",
      "path": "crates/trust/x509/tests",
      "local_equivalent": "cargo test -p reallyme-trust-x509",
      "notes": "X.509 signature, QCStatements, QWAC/QSeal/QSig presets, TSL policy, and wasm fail-closed vectors."
    },
    {
      "source": "W3C-VC-DM-2.0/status",
      "path": "crates/status/tests/status_tests.rs",
      "local_equivalent": "cargo test -p reallyme-credential-status",
      "notes": "Local status-list validation vectors; fetching remains outside identity."
    },
    {
      "source": "CONTRACT/did:me/data-integrity",
      "path": "crates/did/core/engine/tests and crates/envelopes/data_integrity/tests",
      "local_equivalent": "cargo test -p reallyme-did-core-engine -p envelopes-data-integrity",
      "notes": "did:me core/projection validation and es256-jws-cid-2025 Data Integrity suite vectors."
    },
    {
      "source": "EUDI-ARF/claims/audit",
      "path": "crates/claims/tests and crates/audit/tests",
      "local_equivalent": "cargo test -p reallyme-credential-claims -p reallyme-credential-audit",
      "notes": "Credential claim registry, disclosure policy, and QEAA audit-evidence validation vectors."
    },
    {
      "source": "RFC9126/RFC9449",
      "path": "crates/oauth/tests/oauth_substrate_tests.rs",
      "local_equivalent": "cargo test -p reallyme-openid-oauth",
      "notes": "Shared OAuth substrate vectors for protocol crates; endpoint behavior remains outside identity."
    }
