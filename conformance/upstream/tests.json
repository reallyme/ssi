    {
      "source": "RFC7515/RFC7519/RFC8725",
      "path": "crates.io:reallyme-jose@0.4.0/tests",
      "local_equivalent": "cargo test -p reallyme-jose --features native",
      "notes": "JWS/JWT algorithm-policy, token-type, temporal, and malformed-input vectors.",
      "test_names": [
        "can_encode_and_decode_custom_typ_when_policy_allows_it",
        "can_require_typ_presence",
